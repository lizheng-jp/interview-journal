# REVIEW ONLY — standalone addition to existing imported sites directory.
# web must join the approved Caddy Docker network with this UNIQUE alias.
# Replace domain and password hash outside Git. Do not use existing frontend alias.
interview.example.com {
    basic_auth {
        owner REPLACE_WITH_CADDY_PASSWORD_HASH
    }
    header {
        X-Robots-Tag "noindex, nofollow, noarchive"
        Referrer-Policy "same-origin"
        X-Content-Type-Options "nosniff"
    }
    request_body {
        max_size 105MB
    }
    reverse_proxy interview-journal-web:3000
}
