# Copy to .env; never commit populated environment files.
INTERVIEW_LOCAL_PORT=13080
LOCAL_DB_PORT=15432
# Generate outside Git. Use hexadecimal characters for a URL-safe local password.
LOCAL_POSTGRES_PASSWORD=
OWNER_ID=local-owner
MAX_UPLOAD_MB=100
WHISPER_MODEL=base
# Production ONLY after approval: a dedicated role, never existing business credentials.
# DATABASE_URL=postgresql+psycopg://interview_user:REPLACE_OUTSIDE_GIT@db:5432/interview_db
# EXISTING_POSTGRES_NETWORK=REPLACE_AFTER_READ_ONLY_INSPECTION
# APP_ORIGINS=http://localhost:13080,http://127.0.0.1:13080
# APP_ORIGIN=https://REPLACE_WITH_APPROVED_DOMAIN
